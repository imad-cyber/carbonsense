# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=CarbonSense
APP_VERSION=1.0.0
DEBUG=False

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/carbonsense

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-with-python-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MLflow / models ──────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=carbonsense-emissions
MODEL_DIR=models

# ── RAG / LLM (Phase 7) ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
VECTOR_STORE_PATH=vector_store
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# ── Kafka (Phase 8) — leave empty to disable ─────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EMISSION_TOPIC=emission-events
KAFKA_ALERT_TOPIC=emission-alerts

# ── CORS — comma-separated frontend origins ──────────────────────────────────
CORS_ORIGINS=http://localhost:3000
